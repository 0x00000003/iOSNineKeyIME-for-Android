  "schema_version": 1,
  "forbidden_permissions": [
    "android.permission.INTERNET"
  ],
  "allow_backup": false,
  "allow_shared_uid": false,
  "allow_backup_agent": false,
  "allow_runtime_network": false,
  "runtime_assets_bundled": true,
